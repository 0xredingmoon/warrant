{
  "name": "@warrant/relayer",
  "version": "0.1.0",
  "description": "Gas-paying relayer for Warrant: submits agent-signed payment intents (agents need no gas)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "warrant-relayer": "./dist/server.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --dts --clean",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@warrant/sdk": "workspace:*",
    "express": "^4.21.0",
    "viem": "^2.21.0",
    "zod": "^3.23.0",
    "@warrant/store": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
