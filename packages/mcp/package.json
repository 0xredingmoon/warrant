{
  "name": "@warrant/mcp",
  "version": "0.1.0",
  "description": "MCP server: lets any LLM agent check and pay under a Warrant mandate",
  "license": "MIT",
  "type": "module",
  "bin": { "warrant-mcp": "./dist/server.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --dts --clean",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@warrant/sdk": "workspace:*",
    "viem": "^2.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
