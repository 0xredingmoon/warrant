{
  "name": "warrant",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Spending mandates for AI agents on stablecoins (Aevum Builder Challenge #1)",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "abis": "node scripts/gen-abis.mjs",
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r typecheck",
    "test:sdk": "pnpm --filter @warrant/sdk test",
    "fork": "bash scripts/fork.sh",
    "demo": "pnpm --filter @warrant/demo demo",
    "demo:fork": "pnpm --filter @warrant/demo demo:fork",
    "demo:aevum": "pnpm --filter @warrant/demo demo:aevum",
    "relayer": "pnpm --filter @warrant/relayer start",
    "mcp": "pnpm --filter @warrant/mcp start",
    "web:dev": "pnpm --filter @warrant/web dev",
    "web:build": "pnpm --filter @warrant/web build",
    "web:static": "STATIC_EXPORT=1 pnpm --filter @warrant/web exec next build",
    "web:serve": "node scripts/serve-web.mjs",
    "e2e:attack": "node web/e2e/verify-attack-demo.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@warrant/relayer": "workspace:*",
    "express": "^4.21.0"
  }
}
