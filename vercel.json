{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "corepack enable --install-directory ./.bin && export PATH=\"$PWD/.bin:$PATH\" && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @warrant/sdk --filter @warrant/store --filter @warrant/relayer build",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/api/$1" }
  ],
  "functions": {
    "api/[[...path]].ts": {
      "maxDuration": 180,
      "memory": 1024
    }
  }
}
